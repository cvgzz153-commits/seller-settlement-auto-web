# 실제 키는 절대 Git에 커밋하지 마세요. Vercel Project Settings > Environment Variables에 등록합니다.

# 토스페이먼츠: 브라우저에서 쓰는 공개 Client Key
TOSS_CLIENT_KEY=test_ck_your_client_key

# 토스페이먼츠: 서버리스 API에서만 쓰는 Secret Key
TOSS_SECRET_KEY=test_sk_your_secret_key

# 실제 결제 승인 활성화 전까지 false로 유지합니다.
PAYMENTS_LIVE_ENABLED=false

# Vercel의 실제 운영 도메인. 예: https://settlemate.vercel.app
APP_ORIGIN=https://your-domain.vercel.app

# 문의 채널. GitHub Issues, Google Form 또는 고객지원 페이지 주소를 넣습니다.
CONTACT_URL=https://github.com/cvgzz153-commits/seller-settlement-auto-web/issues/new

# 자동 알림 발송: 실제 공급자 계약·수신 동의·템플릿 승인 전까지 false로 유지합니다.
NOTIFICATION_LIVE_ENABLED=false
NOTIFICATION_PROVIDER=alimtalk_or_sms_provider
NOTIFICATION_API_KEY=replace_with_provider_api_key
NOTIFICATION_SENDER_PROFILE_ID=replace_with_approved_sender_profile
